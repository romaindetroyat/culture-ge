{
  "name": "lombrix-iphone",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": ["/api/*", "/health"] },
  "durable_objects": { "bindings": [{ "name": "GAMES", "class_name": "GameAuthority" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameAuthority"] }],
  "observability": { "enabled": false }
}
